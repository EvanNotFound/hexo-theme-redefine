{
  "name": "hexo-theme-redefine",
  "version": "2.9.0",
  "private": false,
  "packageManager": "pnpm@10.29.3",
  "description": "Redefine your writing with Hexo Theme Redefine.",
  "scripts": {
    "npm:publish": "npm run build && npm publish",
    "build": "tailwindcss -i source/css/tailwind.source.css -o source/css/build/tailwind.css --minify && node source/js/build.js",
    "build:css": "tailwindcss -i source/css/tailwind.source.css -o source/css/build/tailwind.css --minify",
    "build:js": "node source/js/build.js",
    "clean": "node dev/clean.mjs",
    "watch:css": "tailwindcss -i source/css/tailwind.source.css -o source/css/build/tailwind.css --watch --minify",
    "prepare": "husky",
    "dev": "node dev/dev.mjs",
    "dev:setup": "pnpm install --frozen-lockfile --prefer-offline"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EvanNotFound/hexo-theme-redefine.git"
  },
  "keywords": [
    "hexo",
    "theme",
    "redefine",
    "simple",
    "pure",
    "powerful",
    "hexo-theme"
  ],
  "author": "EvanNotFound",
  "license": "GPL-3.0",
  "bugs": {
    "url": "https://github.com/EvanNotFound/hexo-theme-redefine/issues"
  },
  "homepage": "https://redefine.ohevan.com",
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.11",
    "eslint": "^8.47.0",
    "glob-promise": "^6.0.7",
    "husky": "^9.1.6",
    "postcss": "^8.4.47",
    "tailwindcss": "^4.1.11",
    "terser": "^5.36.0"
  }
}

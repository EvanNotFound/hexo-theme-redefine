[
  {
    "label": "Redefine worktree setup",
    "command": "pnpm",
    "args": ["install", "--frozen-lockfile", "--prefer-offline"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "hooks": ["create_worktree"],
    "reveal": "no_focus",
    "hide": "on_success",
    "save": "none"
  },
  {
    "label": "Redefine dev",
    "command": "pnpm",
    "args": ["dev"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": true,
    "reveal": "always",
    "save": "all"
  }
]

<div class="box-border mb-4 rounded-none border-0 bg-rd-background-100 px-1 py-5 shadow-none sm:mb-8 sm:rounded-2xl sm:border sm:border-rd-gray-alpha-400 sm:p-8 sm:shadow-rd">
    <% if (pageBody) { %><%- pageBody %><% } %>

    <div class="markdown-body text-rd-gray-1000">
        <% if (!pageBody) { %><h1><%- page.title %></h1><% } %>
        <%- page.content %>
    </div>

    <% if (page.comment === true || page.comments === true) { %>
        <%- partial('components/comments/index') %>
    <% } %>
</div>

<%- partial('components/paginator') %>

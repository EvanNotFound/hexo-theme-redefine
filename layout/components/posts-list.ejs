<% const postList = createNewArchivePosts(posts); %>
<div>
    <% postList.forEach((postYear) => { %>
        <section class="mb-10 last:mb-0">
            <h2 class="mb-3 flex items-center gap-4">
                <span class="text-2xl sm:text-3xl font-semibold"><%= postYear.year %></span>
                <span class="text-2xl sm:text-3xl font-light text-rd-gray-800 tracking-tight"><%= postYear.postList.length %> <%= postYear.postList.length === 1 ? __('post') : __('posts') %></span>
            </h2>
            <%
                const groups = [];
                postYear.postList.forEach((post) => {
                    const postDate = date(post.date, 'YYYY-MM-DD');
                    let group = groups[groups.length - 1];
                    if (!group || group.key !== postDate) {
                        group = {key: postDate, date: post.date, posts: []};
                        groups.push(group);
                    }
                    group.posts.push(post);
                });
            %>
            <ol class="timeline pl-2 md:pl-8">
                <% groups.forEach((group) => { %>
                    <li class="timeline-entry relative border-l border-rd-gray-alpha-400 pb-6 pl-6 last:pb-2">
                        <div class="mb-2 text-sm font-semibold text-rd-gray-900"><%- time_tag(group.date, 'MMM D') %></div>
                        <ul class="space-y-1.5">
                            <% group.posts.forEach((post) => { %>
                                <li class="timeline-post relative">
                                    <a href="<%- url_for(post.path) %>" class="block w-fit max-w-full">
                                        <span class="block text-lg leading-snug text-rd-gray-1000 [overflow-wrap:anywhere] md:text-xl"><%= post.title %></span>
                                    </a>
                                </li>
                            <% }); %>
                        </ul>
                    </li>
                <% }); %>
            </ol>
        </section>
    <% }); %>
</div>

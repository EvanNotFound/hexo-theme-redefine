<dialog id="local-search" class="search m-auto h-[80%] w-9/10 max-w-none scale-95 overflow-hidden rounded-3xl border-0 bg-rd-background-100 p-0 transition-transform duration-300 open:scale-100 sm:w-4/5 md:w-7/10" aria-labelledby="local-search-label">
    <div class="flex bg-rd-gray-300 p-2.5">
        <button type="button" data-search-action="clear" class="flex items-center px-2.5 text-[1.2rem] text-rd-gray-900" aria-label="Clear search" title="Clear search">
            <i class="fa-solid fa-keyboard" aria-hidden="true"></i>
        </button>
        <label id="local-search-label" for="local-search-input" class="sr-only"><%= __('search') %></label>
        <div class="grow p-0.5">
            <input id="local-search-input" autocomplete="off" autocorrect="off" autocapitalize="off" placeholder="<%= __('search') %>" spellcheck="false" type="search" class="w-full border-0 bg-transparent text-[1.2rem] text-rd-gray-1000 outline-0">
        </div>
        <button type="button" data-search-action="close" class="flex items-center px-2.5 text-[1.2rem] text-rd-gray-1000 hover:text-rd-gray-1000" aria-label="<%= __('close') %>" title="<%= __('close') %>">
            <i class="fa-solid fa-times" aria-hidden="true"></i>
        </button>
    </div>
    <div id="local-search-results" class="flex h-[calc(100%_-_55px)] overflow-auto px-[25px] py-[5px]">
        <div id="local-search-status" class="m-auto text-rd-gray-900" aria-live="polite">
            <i class="fa-solid fa-spinner fa-spin-pulse fa-5x fa-fw" aria-hidden="true"></i>
        </div>
    </div>
</dialog>

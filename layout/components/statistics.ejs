<div class="statistics flex justify-around my-2.5">
    <a data-navbar-close class="item tag-count-item flex flex-col justify-center items-center w-20" href="<%- url_for(config.tag_dir) %>">
        <div class="number text-xl text-rd-gray-1000 font-semibold"><%= site.tags.length %></div>
        <div class="label text-rd-gray-900 text-sm"><%- __('tags') %></div>
    </a>
    <a data-navbar-close class="item tag-count-item flex flex-col justify-center items-center w-20" href="<%- url_for(config.category_dir) %>">
        <div class="number text-xl text-rd-gray-1000 font-semibold"><%= site.categories.length %></div>
        <div class="label text-rd-gray-900 text-sm"><%- __('categories') %></div>
    </a>
    <a data-navbar-close class="item tag-count-item flex flex-col justify-center items-center w-20" href="<%- url_for(config.archive_dir) %>">
        <div class="number text-xl text-rd-gray-1000 font-semibold"><%= site.posts.length %></div>
        <div class="label text-rd-gray-900 text-sm"><%- __('posts') %></div>
    </a>
</div>

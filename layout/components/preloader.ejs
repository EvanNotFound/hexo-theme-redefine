<div id="preloader" data-state="visible" role="status" aria-live="polite" aria-busy="true" class="fixed inset-0 z-10 flex h-screen w-screen flex-col items-center justify-center gap-4 bg-rd-background-100 p-3 opacity-100 transition-opacity duration-200 ease-in-out data-[state=hiding]:opacity-0">
    <h2 id="preloader-message" class="text-center font-display text-4xl leading-none font-medium tracking-normal text-rd-gray-1000 sm:text-5xl"><%= theme.global.preloader.custom_message || theme.info.title %></h2>
    <script>
        (() => {
            const preloader = document.getElementById('preloader');
            const message = document.getElementById('preloader-message');
            if (!preloader || !message) return;

            const words = message.textContent.trim().split(' ');
            message.innerHTML = '';
            words.forEach((word) => {
                const wordSpan = document.createElement('span');
                wordSpan.dataset.preloaderWord = '';
                wordSpan.innerHTML = word.replace(/\S/g, '<span data-preloader-letter>$&</span>');
                message.appendChild(wordSpan);
                message.appendChild(document.createTextNode(' '));
            });

            let animation = null;
            let hidden = false;
            const hidePreloader = () => {
                if (hidden) return;
                hidden = true;
                animation?.pause();
                preloader.dataset.state = 'hiding';
                preloader.setAttribute('aria-busy', 'false');
                window.setTimeout(() => {
                    preloader.hidden = true;
                }, 200);
            };

            if (window.matchMedia?.('(prefers-reduced-motion: reduce)').matches) {
                window.addEventListener('load', hidePreloader, {once: true});
                return;
            }

            animation = anime.timeline({loop: false})
                .add({
                    targets: '[data-preloader-letter]',
                    translateY: [20, 0],
                    translateZ: 0,
                    opacity: [0, 1],
                    filter: ['blur(5px)', 'blur(0px)'],
                    easing: 'easeOutExpo',
                    duration: 1200,
                    delay: (element, index) => 300 + 20 * index,
                })
                .add({
                    targets: '[data-preloader-letter]',
                    translateY: [0, -20],
                    opacity: [1, 0],
                    filter: ['blur(0px)', 'blur(5px)'],
                    easing: 'easeInExpo',
                    duration: 1000,
                    delay: (element, index) => 15 * index,
                    complete: hidePreloader,
                }, '-=700');

            window.addEventListener('load', () => window.setTimeout(hidePreloader, 5000), {once: true});
        })();
    </script>
</div>

<!-- using ring to avoid border wrapping around post thumbnail -->
<li data-home-card class="relative flex box-border flex-col mb-6 overflow-hidden rounded-2xl ring-inset ring ring-rd-gray-alpha-400 sm:mb-8 md:mb-10 group">
    <% if (post.sticky) { %>
        <div data-sticky-label class="absolute top-3 right-3 z-10 cursor-default rounded-full border border-rd-gray-alpha-400 bg-rd-background-100/15 px-2.5 py-0.5 text-xs text-rd-gray-900 hover:text-rd-gray-1000">
            <i class="fa-regular fa-thumbtack mr-1 text-xs" aria-hidden="true"></i><%- __('sticky') %>
        </div>
    <% } %>

    <%
        let articleThumbnail = "";
        if (post.cover || post.banner || (post.thumbnail && post.thumbnail !== false)) {
            if (post.thumbnail && post.thumbnail !== null) {
                articleThumbnail = post.thumbnail;
            } else if (post.cover && post.cover.includes("/")) {
                articleThumbnail = post.cover;
            } else if (post.banner && post.banner.includes("/")) {
                articleThumbnail = post.banner;
            } else if (config.marked.postAsset === true) {
                articleThumbnail = [post.path, post.cover || post.banner].join("/");
            }
        }
    %>

    <% if (post.thumbnail !== false && (post.thumbnail || post.cover || post.banner)) { %>
        <div class="relative -mb-1 h-40 w-full overflow-hidden">
            <a href="<%- url_for(post.path) %>">
                <img src="<%- url_for(articleThumbnail) %>" alt="<%= post.title %>" class="absolute top-1/2 h-full w-full -translate-y-1/2 object-cover transition-all dark:brightness-75 group-hover:scale-102 duration-500" />
            </a>
        </div>
    <% } %>
    <div class="flex flex-col gap-2 p-5 border-b border-rd-gray-alpha-300">
        <!-- post title -->
        <h3 class="relative m-0 font-[family-name:var(--font-article-title)] text-xl leading-normal font-semibold text-rd-gray-1000 sm:text-xl">
            <a href="<%- url_for(post.path) %>"><%= post.title %></a>
        </h3>

        <div class="markdown-body text-justify text-rd-gray-1000 [overflow-wrap:break-word]">
            <% if (post.excerpt && post.excerpt == "false") { %>
            <% } else if (post.excerpt && post.excerpt !== "false") { %>
                <%- render(post.excerpt, "markdown") %>
            <% } else { %>
                <% const excerptLength = theme.home.excerpt_length || 200; %>
                <%- truncate(strip_html(post.content), {length: excerptLength}) %>
            <% } %>
        </div>

        <%
            let homeWordCount = 0;
            let homeMin2read = 0;
            if (theme.home.word_count?.enable) {
                try {
                    homeWordCount = wordcount(post.content);
                    homeMin2read = min2read(post.content);
                } catch (e) {
                    homeWordCount = 0;
                    homeMin2read = 0;
                }
            }
        %>
        <div class="flex flex-wrap items-center mt-2 justify-between gap-x-4 gap-y-2 text-sm text-rd-gray-900">
            <time data-home-article-date class="flex items-center gap-1.5" data-date="<%= post.date %>" datetime="<%= date_xml(post.date) %>">
                <i class="fa-regular fa-pen-swirl"></i>
                <% if (theme.home.article_date_format == 'auto' || theme.home.article_date_format == 'relative') { %>
                    <%= date(post.date, config.date_format) %>
                <% } else { %>
                    <%= date(post.date, theme.home.article_date_format) %>
                <% } %>
            </time>
            <% if ((theme.home.word_count.count && homeWordCount) || (theme.home.word_count.min2read && homeMin2read)) { %>
                <div class="ml-auto flex items-center gap-3">
                    <% if (theme.home.word_count.count && homeWordCount) { %>
                        <span data-home-word-count class="flex items-center gap-1.5"><i class="fa-regular fa-typewriter" aria-hidden="true"></i><%= homeWordCount %> <%- __('wordcount') %></span>
                    <% } %>
                    <% if (theme.home.word_count.min2read && homeMin2read) { %>
                        <span data-home-reading-time class="flex items-center gap-1.5"><i class="fa-regular fa-clock" aria-hidden="true"></i><%= homeMin2read %> <%- __('min2read') %></span>
                    <% } %>
                </div>
            <% } %>
        </div>
    </div>
    <div class="flex py-3 px-5 justify-between items-center">
        <div class="w-full gap-x-2.5 gap-y-1 flex items-center">
            <% if (post.categories.length && theme.home.categories.enable === true) { %>
                <%
                    const categoryPaths = getCategoryPaths(post.categories);
                    const categoryLimit = Number(theme.home.categories.limit);
                    const visibleCategoryPaths = categoryLimit > 0 ? categoryPaths.slice(0, categoryLimit) : categoryPaths;
                %>
                <div class="hidden min-w-0 items-center gap-1.5 sm:flex">
                    <i class="fa-regular fa-folder-closed shrink-0 text-sm text-rd-gray-900" aria-hidden="true"></i>
                    <ul class="flex min-w-0 flex-wrap gap-1.5" aria-label="<%= __('categories') %>">
                        <% visibleCategoryPaths.forEach((categoryPath) => { %>
                            <li data-home-category-path class="flex max-w-full items-center rounded-md border border-rd-gray-alpha-300 bg-rd-gray-100/30 px-2 py-0.5 text-xs">
                                <% categoryPath.forEach((category, index) => { %>
                                    <% if (index > 0) { %><i class="fa-regular fa-angle-right mx-1 shrink-0 text-xs text-rd-gray-800" aria-hidden="true"></i><% } %>
                                    <a class="min-w-0 truncate text-rd-gray-900 hover:text-primary" href="<%- url_for(category.path) %>"><%= category.name %></a>
                                <% }); %>
                            </li>
                        <% }); %>
                    </ul>
                </div>
            <% } %>
            <% if (post.tags.length && theme.home.tags.enable === true) { %>
                <span class="hidden items-center gap-1.5 md:flex">
                    <i class="fa-regular fa-hashtag text-sm text-rd-gray-900" aria-hidden="true"></i>
                    <ul class="flex flex-wrap gap-0.5">
                        <% post.tags.forEach((tag, i) => { %>
                            <% if (theme.home.tags.limit === 0 || i + 1 <= theme.home.tags.limit) { %>
                                <li class="flex"><a class="rounded-full border border-rd-gray-alpha-300 bg-rd-gray-100/30 px-2 py-0.5 text-xs text-rd-gray-900 hover:text-primary" href="<%- url_for(tag.path) %>"><%= tag.name %></a></li>
                            <% } %>
                        <% }); %>
                    </ul>
                </span>
            <% } %>
        </div>
        <a
            class="group/read-more tracking-tight text-sm flex shrink-0 items-center gap-1.5 whitespace-nowrap"
            href="<%- url_for(post.path) %>"
        >
            <span class="text-rd-gray-900"><%- __('read_more') %></span>
            <span class="sr-only"><%= post.title %></span>
            <i class="fa-regular text-xs fa-arrow-right group-hover/read-more:translate-x-0.5 transition-transform text-rd-gray-900" aria-hidden="true"></i>
        </a>
    </div>

</li>

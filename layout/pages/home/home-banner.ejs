<% if (theme.home_banner.style === "fixed") { %>
    <%- partial('pages/home/home-banner-image', {fixed: true, blurred: false}) %>
<% } %>

<section id="home-banner" class="transition-fade relative flex min-h-screen w-full box-border items-center justify-center overflow-hidden font-home will-change-transform">
    <% if (theme.home_banner.style !== "fixed") { %>
        <%- partial('pages/home/home-banner-image', {fixed: false, blurred: false}) %>
    <% } %>
    <div class="transition-fade-down relative mt-8 flex min-h-[90vh] box-border flex-col items-center justify-center">
        <div class="home-title flex w-screen flex-col items-center justify-center text-center text-[length:calc(var(--home-title-size)*0.9)] leading-[var(--home-line-height)] font-medium text-home-banner-text-color md:text-[length:var(--home-title-size)]">
            <%- theme.home_banner.title || theme.style.first_screen.description || config.description %>
            <% const subtitleConfig = theme.home_banner.subtitle || {}; %>
            <% const subtitleText = subtitleConfig.text; %>
            <% const subtitleEntries = Array.isArray(subtitleText) ? subtitleText : subtitleText ? [subtitleText] : []; %>
            <% if (subtitleEntries.length !== 0 || (subtitleConfig.hitokoto && subtitleConfig.hitokoto.enable)) { %>
                <p><i id="subtitle"></i></p>
            <% } %>
        </div>

        <% if (theme.home_banner.social_links.enable) { %>
            <%
                const flexDirection = theme.home_banner.social_links.style === "reverse" ? "flex-row-reverse" : "flex-row";
                const justify = theme.home_banner.social_links.style === "center" ? "justify-center" : "justify-between";
                const scrollDisplay = theme.home_banner.social_links.style === "center" ? "hidden" : "flex";
                const socialLinks = theme.home_banner.social_links || {};
                const links = Array.isArray(socialLinks.links) ? socialLinks.links : [];
                const qrs = Array.isArray(socialLinks.qrs) ? socialLinks.qrs : [];
                const hasQrs = qrs.some((item) => item && item.qr);
                const normalizeIcon = (iconValue, fallbackName) => {
                    const source = iconValue || fallbackName || "";
                    if (!source) return "";
                    if (source === "email") return "fa-solid fa-at";
                    if (source.startsWith('/') || source.startsWith('http')) return source;
                    if (source.includes('fa-')) return source;
                    return `fa-brands fa-${source}`;
                };
            %>
            <div class="absolute bottom-0.5 flex w-full max-w-[1340px] items-center px-8 sm:px-12 <%- flexDirection %> <%- justify %>">
                <button id="scroll-to-main" type="button" aria-label="Scroll to content" title="Scroll to content" class="<%- scrollDisplay %> aspect-square h-full cursor-pointer items-center justify-center rounded-full border border-white/20 bg-gray-300/50 p-3 backdrop-blur-lg dark:border-gray-500/30 dark:bg-gray-500/40">
                    <i class="fa-solid fa-arrow-down fa-fw fa-lg transition-transform hover:translate-y-1" aria-hidden="true"></i>
                </button>
                <div class="flex flex-row items-center gap-3 rounded-full border border-white/20 bg-gray-300/50 px-6 py-3 backdrop-blur-lg dark:border-gray-500/30 dark:bg-gray-500/40">
                    <% for (const item of links) { %>
                        <% if (item && item.url) { %>
                            <%
                                const name = item.name || "";
                                const icon = normalizeIcon(item.icon, name);
                                const isEmail = name === "email" || (icon && icon.includes("fa-at"));
                                const resolvedUrl = isEmail && !item.url.startsWith("mailto:") ? `mailto:${item.url}` : item.url;
                            %>
                            <a href="<%- resolvedUrl %>" <%- isEmail ? '' : 'target="_blank" rel="noopener noreferrer"' %> aria-label="<%= name || 'Social link' %>">
                                <% if (icon && icon.includes("fa-")) { %>
                                    <i class="<%= icon %> fa-fw fa-lg" aria-hidden="true"></i>
                                <% } else if (icon && (icon.startsWith('/') || icon.startsWith('http'))) { %>
                                    <img src="<%- url_for(icon) %>" alt="" class="h-5 w-5 object-contain" aria-hidden="true">
                                <% } %>
                            </a>
                        <% } %>
                    <% } %>

                    <% if (hasQrs) { %>
                        <div class="mx-0.5 h-4 w-px bg-home-banner-text-color/40" aria-hidden="true"></div>
                        <% qrs.forEach((item, index) => { %>
                            <% if (item && item.qr) { %>
                                <%
                                    const name = item.name || "QR code";
                                    const icon = normalizeIcon(item.icon, item.name || "");
                                    const qrId = `home-qr-${index}`;
                                %>
                                <span class="qr group relative cursor-pointer" data-qr data-state="closed">
                                    <button type="button" data-qr-trigger aria-controls="<%= qrId %>" aria-expanded="false" aria-label="<%= name %>" class="flex items-center justify-center">
                                        <% if (icon && icon.includes("fa-")) { %>
                                            <i class="<%= icon %> fa-fw fa-lg" aria-hidden="true"></i>
                                        <% } else if (icon && (icon.startsWith('/') || icon.startsWith('http'))) { %>
                                            <img src="<%- url_for(icon) %>" alt="" class="h-5 w-5 object-contain" aria-hidden="true">
                                        <% } %>
                                    </button>
                                    <div id="<%= qrId %>" data-qr-popup aria-hidden="true" class="invisible absolute right-0 bottom-0 mb-14 h-auto translate-y-0.5 overflow-hidden rounded-3xl border border-white/20 bg-rd-background-100/40 opacity-0 transition-all group-hover:visible group-hover:translate-y-0 group-hover:opacity-100 dark:border-gray-500/30">
                                        <img class="w-64" src="<%- url_for(item.qr) %>" alt="<%= name %>">
                                    </div>
                                </span>
                            <% } %>
                        <% }); %>
                    <% } %>
                </div>
            </div>
        <% } %>
    </div>
</section>

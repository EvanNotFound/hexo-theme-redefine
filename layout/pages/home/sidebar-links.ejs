<div data-sidebar-panel class="box-border overflow-hidden rounded-lg border border-rd-border bg-background-color p-[15px] <%= separated ? 'mt-[calc(var(--spacing-unit)*0.6)]' : '' %>">
    <div data-sidebar-header class="-mx-[15px] -mt-[15px] mb-2.5 rounded-t-lg border-b border-rd-border bg-second-background-color p-[15px]">
        <div class="text-center font-[family-name:var(--font-title)] text-[1.2rem] font-medium text-second-text-color"><%= theme.info.title || config.title %></div>
        <% if (hasSidebarAnnouncement && hasSidebarLinks) { %>
            <div class="mt-2.5 mb-[5px] text-center text-[0.9rem] text-third-text-color"><%- theme.home.sidebar.announcement %></div>
        <% } %>
    </div>
    <% if (hasSidebarLinks) { %>
        <% for (let i in theme.home.sidebar.links) { %>
            <% if (theme.home.sidebar.links[i].path !== 'none') { %>
                <a data-sidebar-link class="flex cursor-pointer items-center justify-center rounded-sm px-0 py-[5px] text-left font-[family-name:var(--font-default)] text-second-text-color hover:bg-second-background-color hover:text-primary" href="<%= url_for(theme.home.sidebar.links[i].path) %>">
                    <% if (theme.home.sidebar.links[i].icon) { %>
                        <i class="<%- theme.home.sidebar.links[i].icon %> mr-[5px] text-[1.2rem]" aria-hidden="true"></i>
                    <% } %>
                    <span class="font-medium"><%= __(i) %></span>
                </a>
            <% } %>
        <% } %>
    <% } else { %>
        <div class="mt-2.5 mb-[5px] flex items-center justify-center px-0 py-[5px] text-center text-second-text-color"><%- theme.home.sidebar.announcement %></div>
    <% } %>
</div>

<%
    const hasSidebarLinks = theme.home.sidebar.links !== null;
    const hasSidebarAnnouncement = theme.home.sidebar.announcement !== null;
    const hasSidebarExtra = hasSidebarLinks || hasSidebarAnnouncement;
%>
<aside class="mx-[var(--spacing-unit)] h-auto w-60 max-[768px]:mx-[calc(var(--spacing-unit)*0.5)] max-[640px]:hidden">
    <div class="sticky top-[var(--navbar-height)]">
        <% if (theme.home.sidebar.first_item === "info") { %>
            <%- partial('pages/home/sidebar-profile', {separated: false}) %>
            <% if (hasSidebarExtra) { %>
                <%- partial('pages/home/sidebar-links', {hasSidebarLinks, hasSidebarAnnouncement, separated: true}) %>
            <% } %>
        <% } else { %>
            <% if (hasSidebarExtra) { %>
                <%- partial('pages/home/sidebar-links', {hasSidebarLinks, hasSidebarAnnouncement, separated: false}) %>
            <% } %>
            <%- partial('pages/home/sidebar-profile', {separated: hasSidebarExtra}) %>
        <% } %>
    </div>
</aside>

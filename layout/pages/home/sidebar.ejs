<%
    const sidebarLinks = getSidebarLinks(theme.home.sidebar.links);
    const announcement = typeof theme.home.sidebar.announcement === 'string' && theme.home.sidebar.announcement.trim()
        ? theme.home.sidebar.announcement
        : null;
    const hasMenu = sidebarLinks.length > 0 || announcement;
    const infoFirst = theme.home.sidebar.first_item === 'info';
    const sidebarPosition = theme.home.sidebar.position === 'right' ? 'order-last' : 'order-first';
%>
<aside class="<%= sidebarPosition %> hidden w-60 shrink-0 self-stretch md:block">
    <div class="sticky top-[calc(var(--current-navbar-height)_+_1rem)] flex flex-col gap-6">
        <div data-sidebar-panel class="<%= infoFirst ? 'order-first' : 'order-last' %> rounded-2xl border border-rd-gray-alpha-400 bg-rd-background-100 p-4">
            <div class="flex justify-center">
                <%- image_tag(theme.defaults.avatar, {class: "h-20 w-20 rounded-2xl border border-rd-gray-alpha-400 p-px"}) %>
            </div>
            <div class="my-2.5 flex flex-col justify-center">
                <div class="text-center text-xl font-semibold text-rd-gray-1000"><%= theme.info.author || config.author %></div>
                <% if (theme.articles?.author_label?.enable === true) { %>
                    <div class="text-center text-xs text-rd-gray-900"><%- getAuthorLabel(site.posts.length, theme.articles.author_label.auto, theme.articles.author_label.list) %></div>
                <% } %>
            </div>
            <%- partial('components/statistics') %>
        </div>

        <% if (hasMenu) { %>
            <nav data-sidebar-panel aria-label="<%= theme.info.title || config.title %>" class="<%= infoFirst ? 'order-last' : 'order-first' %> overflow-hidden rounded-2xl border border-rd-gray-alpha-400 bg-rd-background-100">
                <div data-sidebar-header class="border-b border-rd-gray-alpha-400 bg-rd-gray-100 px-6 py-4 flex flex-col">
                    <div class="text-left font-title text-xl font-medium text-rd-gray-1000"><%= theme.info.title || config.title %></div>
                    <% if (announcement) { %>
                        <div class="text-left text-sm text-rd-gray-900"><%- announcement %></div>
                    <% } %>
                </div>

                <% if (sidebarLinks.length) { %>
                    <ul class="flex flex-col p-2">
                        <% sidebarLinks.forEach((link) => { %>
                            <li>
                                <a data-sidebar-link class="flex w-full items-center gap-1.5 rounded-lg px-3 py-1.5 text-rd-gray-1000 hover:bg-rd-gray-200/30 hover:text-primary font-display text-sm font-medium" href="<%= url_for(link.path) %>">
                                    <% if (link.icon) { %><i class="<%= link.icon %> w-5 text-center text-base" aria-hidden="true"></i><% } %>
                                    <span><%= __(link.label) %></span>
                                </a>
                            </li>
                        <% }); %>
                    </ul>
                <% } %>
            </nav>
        <% } %>
    </div>
</aside>

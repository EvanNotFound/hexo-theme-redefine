<div class="flex flex-col">
	<%- partial('utils/page-title', {title: page.title}) %>
	<% for (const category of theme.links) { %>
	<div class="mt-2 mb-4">
		<h2 class="text-2xl font-bold"><%= category.links_category %></h2>
	</div>
	<% if (category.has_thumbnail == true) { %>
	<ul class="grid grid-cols-2 mb-6 w-full gap-4">
		<% for (const f of category.list) { %>
		<li class="group">
			<a href="<%= f.link %>">
				<div class="rounded-lg border border-rd-border">
					<div class="h-32 overflow-hidden rounded-t-lg md:h-44">
						<img class="rounded-t-lg object-cover w-full h-full" src="<%= f.thumbnail %>" />
					</div>
					<div class="flex min-w-0 flex-row items-center gap-1 overflow-hidden sm:gap-2">
						<div class="h-16 w-16 rounded-bl-lg bg-third-background-color">
							<% if (f.avatar) { %>
							<img class="rounded-bl-lg h-16 w-16 max-w-none" src="<%= f.avatar %>" onerror="this.style.display='none'">
							<% } else { %>
							<i class="fa-solid fa-user-group"></i>
							<% } %>
						</div>
						<div class="flex flex-col min-w-0">
							<div class="truncate text-lg text-second-text-color group-hover:!text-primary"><%= f.name %></div>
							<div class="truncate text-third-text-color"><%= f.description %></div>
						</div>
					</div>
				</div>
			</a>
		</li>
		<% } %>
	</ul>
	<% } else { %>
	<ul class="grid mb-6 gap-4 <%= theme.page_templates.friends_column === 3 ? "grid-cols-2 sm:grid-cols-3" : "grid-cols-2" %>">
		<% for (const f of category.list) { %>
		<li class="group">
			<a href="<%= f.link %>">
				<div class="flex flex-row items-center gap-1 sm:gap-2 overflow-hidden min-w-0 rounded-lg border border-rd-border">
					<div class="h-16 w-16 rounded-bl-lg bg-third-background-color">
						<% if (f.avatar) { %>
						<img class="rounded-l-lg h-16 w-16 max-w-none" src="<%= f.avatar %>" onerror="this.style.display='none'">
						<% } else { %>
						<i class="fa-solid fa-user-group"></i>
						<% } %>
					</div>
					<div class="flex flex-col min-w-0">
						<div class="truncate text-lg text-second-text-color group-hover:!text-primary"><%= f.name %></div>
						<div class="truncate text-third-text-color"><%= f.description %></div>
					</div>
				</div>
			</a>
		</li>
		<% } %>
	</ul>
	<% } %>
	<% } %>
</div>
